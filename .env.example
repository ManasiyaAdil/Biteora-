# CampusBite Environment Configuration
# Payment Gateway Settings

# Environment Mode: 'test' or 'live'
PAYMENT_ENV=test

# Razorpay API Credentials (Get from https://dashboard.razorpay.com/#/app/keys)
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=placeholder_secret_key

# Webhook Secret (Configured in Razorpay Dashboard -> Settings -> Webhooks)
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# Application Base URL (Change to your production domain upon deployment)
APP_URL=http://127.0.0.1:8000
